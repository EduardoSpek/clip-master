<Window x:Class="ClipMaster.Presentation.Views.WebcamOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Webcam" Height="220" Width="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Grid>
        <Border x:Name="WebcamBorder" CornerRadius="110" ClipToBounds="True"
                BorderThickness="3" BorderBrush="#FF00FF00"
                Width="200" Height="200"
                MouseLeftButtonDown="WebcamBorder_MouseLeftButtonDown"
                MouseMove="WebcamBorder_MouseMove"
                MouseLeftButtonUp="WebcamBorder_MouseLeftButtonUp"
                MouseWheel="WebcamBorder_MouseWheel">
            <Grid>
                <Ellipse x:Name="WebcamEllipse" Fill="#2A2A4A"/>
                <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
