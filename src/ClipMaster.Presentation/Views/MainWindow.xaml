<Window x:Class="ClipMaster.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClipMaster.Presentation.ViewModels"
        xmlns:conv="clr-namespace:ClipMaster.Presentation.Converters"
        Title="Clip Master" Height="680" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackground}"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToStatusTextConverter x:Key="BoolToStatus"/>
        <conv:BoolToColorConverter x:Key="BoolToColor"/>
        <conv:RecordingStateToColorConverter x:Key="RecStateToColor"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackground}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#x1F3AC;" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clip Master" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{DynamicResource StatusText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding RecordingTime}"
                           FontSize="18" FontWeight="SemiBold" FontFamily="Consolas"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <Button Grid.Column="2" Content="&#x2600;&#xFE0F;" FontSize="16"
                        Command="{Binding ToggleThemeCommand}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" FontFamily="Segoe UI Emoji" Width="36" Height="36"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8">
            <StackPanel>

                <!-- Recording Status Card -->
                <Border Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="STATUS DA GRAVA&#x00C7;&#x00C3;O" Style="{DynamicResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="Estado"/>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                                    <TextBlock.Text>
                                        <Binding Path="IsRecording" Converter="{StaticResource BoolToStatus}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="6" Padding="12,6"
                                    Background="{Binding IsRecording, Converter={StaticResource RecStateToColor}}">
                                <TextBlock Text="REC" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Main Actions -->
                <Border Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="A&#x00C7;&#x00D5;ES PRINCIPAIS" Style="{DynamicResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="&#x1F534; Gravar"
                                    Command="{Binding StartRecordingCommand}"
                                    Style="{DynamicResource ModernButton}"/>

                            <Button Grid.Column="2" Content="&#x1F4CB; Clipar"
                                    Command="{Binding CreateClipCommand}"
                                    Style="{DynamicResource SecondaryButton}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="&#x1F3AC; H&#x00ED;brido"
                                    Command="{Binding StartHybridAsync}"
                                    Style="{DynamicResource SecondaryButton}"/>

                            <Button Grid.Column="2" Content="&#x2702;&#xFE0F; Clipar Direto"
                                    Command="{Binding ClipAndContinueCommand}"
                                    Style="{DynamicResource SecondaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Toggle Buttons -->
                <Border Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="DISPOSITIVOS" Style="{DynamicResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" IsChecked="{Binding IsWebcamOn}"
                                          Command="{Binding ToggleWebcamCommand}"
                                          Style="{DynamicResource IconToggleButton}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#x1F4F7;" Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Webcam" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Grid.Column="2" IsChecked="{Binding IsMicOn}"
                                          Command="{Binding ToggleMicrophoneCommand}"
                                          Style="{DynamicResource IconToggleButton}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#x1F3A4;" Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Microfone" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="ATALHOS R&#x00C1;PIDOS" Style="{DynamicResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="&#x1F4C1; Abrir Output"
                                    Command="{Binding OpenOutputFolderCommand}"
                                    Style="{DynamicResource SecondaryButton}"/>

                            <Button Grid.Column="2" Content="&#x2699;&#xFE0F; Configura&#x00E7;&#x00F5;es"
                                    Command="{Binding OpenSettingsCommand}"
                                    Style="{DynamicResource SecondaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent Clips -->
                <Border Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="&#x00DA;LTIMO CLIPE" Style="{DynamicResource SectionTitle}"/>
                        <TextBlock Text="{Binding LastClipPath, FallbackValue='Nenhum clipe ainda'}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SecondaryBackground}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Ctrl+Alt+1~8 para atalhos" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x1F4E5; Minimizar" Command="{Binding MinimizeToTrayCommand}"
                            Style="{DynamicResource SecondaryButton}" Padding="12,6" FontSize="11" Margin="0,0,8,0"/>
                    <Button Content="&#x2715; Fechar" Command="{Binding CloseAppCommand}"
                            Background="{DynamicResource DangerColor}" Foreground="White"
                            BorderThickness="0" Padding="12,6" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
